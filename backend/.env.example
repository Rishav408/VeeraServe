# VeeraServe backend environment.
# Copy this file to `.env` and adjust as needed. Never commit the real `.env`.

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
DATABASE_URL=sqlite:///./veeraserve.db

# --- Orders ---
GST_RATE=0.05
PAYMENT_METHODS=cash,upi,card

# --- Auth ---
JWT_SECRET=change-me-in-your-env-min-32-bytes-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Local LLM (LM Studio, OpenAI-compatible API) ---
# LM Studio accepts any non-empty API key. The chat and vision defaults are the low-end
# Qwen2.5-VL-3B GGUF (see docs/MEMORY.md O-1); set LLM_VISION_MODEL separately if you load
# a dedicated vision model.
LLM_BASE_URL=http://localhost:1234/v1
LLM_CHAT_MODEL=qwen2.5-vl-3b-instruct
LLM_VISION_MODEL=qwen2.5-vl-3b-instruct
LLM_EMBEDDING_MODEL=nomic-embed-text
LLM_API_KEY=lm-studio
LLM_CONTEXT_LENGTH=8192
LLM_REQUEST_TIMEOUT_SECONDS=60
# Let the chat model rephrase grounded replies (verification-gated; falls back to templates).
LLM_POLISH_ENABLED=false

# --- Speech-to-text (faster-whisper) ---
STT_MODEL_SIZE=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# --- RAG / vector store (Chroma) ---
VECTOR_STORE_PATH=./chroma_db
RAG_COLLECTION_NAME=menu
RAG_TOP_K=5

# --- Offers / happy hour ---
HAPPY_HOUR_START=16
HAPPY_HOUR_END=18

# --- Policy ---
ALCOHOL_ENABLED=true

# --- Uploads ---
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_TYPES=audio/*,image/*
