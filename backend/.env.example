# VeeraServe backend environment.
# Copy this file to `.env` and adjust as needed. Never commit the real `.env`.

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
DATABASE_URL=sqlite:///./veeraserve.db

# --- Auth ---
JWT_SECRET=change-me-in-your-env-min-32-bytes-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Local LLM (LM Studio, OpenAI-compatible API) ---
# LLM_MODEL is tentative until P6 finalises the model choice (see docs/MEMORY.md O-1).
# LM Studio accepts any non-empty API key.
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen2.5-vl-3b-instruct
LLM_API_KEY=lm-studio
EMBEDDING_MODEL=nomic-embed-text

# --- Uploads ---
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_TYPES=audio/*,image/*
